# Plataforma de reservas — variables de entorno.
# NO commitear valores reales. En Vercel se configuran por entorno.
# .env*.local está en .gitignore.

# Supabase (servidor)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase (auth admin, públicas)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Dev local (tras `npm run db:start`, puertos 544xx):
#   SUPABASE_URL=http://127.0.0.1:54421
#   SUPABASE_SERVICE_ROLE_KEY=  → output de `npm run db:start` (o `npx supabase status`)

# Mercado Pago
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
# Public key (no secreta) para el frontend — habilita el botón Wallet Brick en
# /reservar. Vacía → botón clásico con redirect. Mismo valor que MP_PUBLIC_KEY.
NEXT_PUBLIC_MP_PUBLIC_KEY=
# Secreto de firma del webhook (Webhooks → Clave secreta de la MISMA app que el
# access token). La firma es best-effort; la verdad del pago es la API de MP.
MP_WEBHOOK_SECRET=
# OPCIONAL (solo dev): notification_url por-preference (escape hatch, p. ej. otro
# túnel sin acceso al panel). Dejar VACÍA normalmente: los Webhooks del panel ya
# apuntan a la URL de test (túnel) y prod, con firma validable. Lo que llega por
# esta vía es IPN legacy (`?id=&topic=`) y su firma NUNCA valida (por diseño).
# MP_NOTIFICATION_URL=https://<tunel>/api/webhooks/mercadopago
MP_NOTIFICATION_URL=

# Sitio / feature flags
# Para E2E de pagos local: apuntar al túnel https (ver CLAUDE.md, "E2E de pagos local");
# con localhost MP guarda back_urls vacías → sin redirect de vuelta tras pagar.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Flujo de reserva: off por defecto en prod; se prende al lanzar el Corte 1.
NEXT_PUBLIC_BOOKING_ENABLED=false

# Emails (Resend) + cron
RESEND_API_KEY=
EMAIL_FROM=FOTF Studios <reservas@fotfstudios.cl>
OWNER_EMAIL=
CRON_SECRET=
